#!/bin/bash
#
# Set up an Omarchy desktop in another language, in one command:
#
#   curl -fsSL https://raw.githubusercontent.com/sbelcl/omarchy-language/master/setup | bash
#
# Defaults to Slovenian. Pass a locale for anything else:
#
#   ... | bash -s -- de_DE.UTF-8
#
# Options:
#   --with-clock   also install the Slovenian clock widget (sl only)
#   --no-menu      install the plugin but leave the menu in English
#
# Everything here is idempotent: run it again after an Omarchy update to
# refresh the menu translation against the new defaults.

set -euo pipefail

LOCALE="sl_SI.UTF-8"
WITH_PANELS=0
WITH_MENU=1

PLUGIN_REPO="https://github.com/sbelcl/omarchy-language.git"
PLUGIN_ID="imnos.language"
PANEL_REPOS=(
  "https://github.com/sbelcl/omarchy-clock-l10n.git sbelcl.clock"
  "https://github.com/sbelcl/omarchy-power-l10n.git sbelcl.power"
  "https://github.com/sbelcl/omarchy-audio-l10n.git sbelcl.audio"
  "https://github.com/sbelcl/omarchy-bluetooth-l10n.git sbelcl.bluetooth"
  "https://github.com/sbelcl/omarchy-weather-l10n.git sbelcl.weather"
  "https://github.com/sbelcl/omarchy-monitor-l10n.git sbelcl.monitor"
  "https://github.com/sbelcl/omarchy-agents-l10n.git sbelcl.agents"
  "https://github.com/sbelcl/omarchy-tray-l10n.git sbelcl.tray"
  "https://github.com/sbelcl/omarchy-indicators-l10n.git sbelcl.indicators"
  "https://github.com/sbelcl/omarchy-system-update-l10n.git sbelcl.system-update"
  "https://github.com/sbelcl/omarchy-reminders-l10n.git sbelcl.reminders"
  "https://github.com/sbelcl/omarchy-network-l10n.git sbelcl.network"
)
PLUGIN_DIR="$HOME/.config/omarchy/plugins/$PLUGIN_ID"

say() { printf '\n\033[1m%s\033[0m\n' "$*"; }
note() { printf '  %s\n' "$*"; }
fail() { printf '\nsetup: %s\n' "$*" >&2; exit 1; }

# Steps 3, 4 and 5 are independent of each other: setting the language does not
# need the menu, and the catalog the panels read does not need either. An
# unreachable repo or a cancelled password prompt used to end the run through
# set -e, which left a desktop with panels and no catalog -- every string back
# in English, and nothing on screen saying why. So the ones that can be carried
# are collected here and reported together at the end instead.
unfinished=()
carry() { unfinished+=("$1"); note "could not: $1"; }

while (( $# > 0 )); do
  case "$1" in
    --with-panels | --with-clock) WITH_PANELS=1 ;;
    --no-menu) WITH_MENU=0 ;;
    -h | --help) sed -n '2,20p' "$0" | sed 's|^# \{0,1\}||'; exit 0 ;;
    -*) fail "unknown option '$1'" ;;
    *) LOCALE="$1" ;;
  esac
  shift
done

(( EUID == 0 )) && fail "run this as your own user, not with sudo"
command -v omarchy >/dev/null || fail "this is for Omarchy; 'omarchy' is not on PATH"
command -v localectl >/dev/null || fail "localectl is missing"

# The locale has to be one glibc knows, or systemd will refuse to generate it.
# The list is overridable so test/setup-test.sh can run this script end to end
# against a fixture instead of the machine it happens to be on.
if ! awk -v want="$LOCALE" '$2 == "UTF-8" && $1 == want { found = 1 } END { exit !found }' \
  "${LOCALE_SUPPORTED:-/usr/share/i18n/SUPPORTED}" 2>/dev/null; then
  fail "$LOCALE is not a UTF-8 locale in /usr/share/i18n/SUPPORTED"
fi

say "1/5  Installing the Language plugin"
# This one is not optional: the menu table and the catalog both come out of it,
# so there is nothing for the later steps to do without it.
if [[ -d $PLUGIN_DIR ]]; then
  note "already installed; updating"
  omarchy plugin update "$PLUGIN_ID" --yes >/dev/null 2>&1 || note "no update available"
elif ! omarchy plugin add "$PLUGIN_REPO" --enable --yes; then
  # add installs and then enables, and the enable half fails on its own when
  # the shell has not rescanned yet. Only a missing folder is fatal here.
  [[ -d $PLUGIN_DIR ]] ||
    fail "could not install the plugin from $PLUGIN_REPO -- is the network up?"
  note "installed, but not enabled yet"
fi
[[ -d $PLUGIN_DIR ]] || fail "expected the plugin at $PLUGIN_DIR; it is not there"

if (( WITH_PANELS )); then
  say "2/5  Installing the translated panels"
  # Each declares clonedFrom, so the shell gives it the built-in's slot in the
  # bar and hands the built-in back if it is ever removed.
  for entry in "${PANEL_REPOS[@]}"; do
    read -r repo id <<<"$entry"
    if [[ -d "$HOME/.config/omarchy/plugins/$id" ]]; then
      note "$id already installed; updating"
      omarchy plugin update "$id" --yes >/dev/null 2>&1 || true
    elif ! omarchy plugin add "$repo" --enable --yes; then
      # `add` copies the plugin in and then enables it, and the enable half
      # fails on its own when the running shell has not rescanned yet
      # ("plugin is not known; run: omarchy-shell shell rescanPlugins"). The
      # files being in place is the common case, so that is not a lost install.
      [[ -d "$HOME/.config/omarchy/plugins/$id" ]] || carry "install $id from $repo"
    fi
  done

else
  say "2/5  Skipping the translated panels (pass --with-panels to translate the bar)"
fi

# An installed plugin that is not enabled is the quietest way for this to go
# wrong: the built-in keeps the slot, so the bar looks right and reads English,
# and a second run takes the "already installed" branch and never revisits it.
# Ask the shell to rescan -- which is exactly what a failed enable asks for --
# and try again.
to_enable=()
for entry in "$PLUGIN_REPO $PLUGIN_ID" "${PANEL_REPOS[@]}"; do
  read -r repo id <<<"$entry"
  [[ $id == "$PLUGIN_ID" || $WITH_PANELS == 1 ]] || continue
  [[ -d "$HOME/.config/omarchy/plugins/$id" ]] || continue
  omarchy plugin list --json 2>/dev/null |
    jq -e --arg id "$id" 'any(.[]; .id == $id and .enabled)' >/dev/null 2>&1 ||
    to_enable+=("$id")
done

if (( ${#to_enable[@]} )); then
  note "${#to_enable[@]} installed but not enabled; asking the shell to rescan"
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  for id in "${to_enable[@]}"; do
    omarchy plugin enable "$id" >/dev/null 2>&1 ||
      carry "enable $id (it is installed; 'omarchy-restart-shell' should pick it up)"
  done
fi

say "3/5  Setting the system language to $LOCALE"
# systemd-localed stops when idle, so the first call after a quiet spell can
# come back slow or empty. Read it once and treat "could not tell" as "not
# set": set-locale is a no-op when it already matches, and a needless password
# prompt is worse than a needless no-op.
current_locale=$(localectl status 2>/dev/null | sed -n 's/.*LANG=\([^ ]*\).*/\1/p' | head -1 || true)
if [[ $current_locale == "$LOCALE" ]]; then
  note "already set"
else
  note "asking systemd to set it -- this may want your password, and will"
  note "generate the locale if nobody has yet"
  # A cancelled prompt is a plausible answer, not a reason to abandon the menu
  # and the catalog: both are this user's own files and neither waits on LANG.
  localectl set-locale "LANG=$LOCALE" || carry "set the system language to $LOCALE"
fi

if (( WITH_MENU )); then
  say "4/5  Translating the Omarchy menu"
  table="${LOCALE%%.*}"
  table="${table%%@*}"
  if [[ -f "$PLUGIN_DIR/translations/$table.tsv" ]]; then
    if "$PLUGIN_DIR/menu-translate" apply "$table"; then
      note "$("$PLUGIN_DIR/menu-translate" status)"
    else
      carry "translate the menu into $table"
    fi
    # Super+K reads the same table. Rebinding it edits the user's own
    # bindings.lua, inside a marked block that `menu-keybindings unbind` takes
    # back out.
    if [[ ! -x "$PLUGIN_DIR/menu-keybindings" ]]; then
      note "this plugin version cannot translate Super+K"
    elif [[ ! -f $HOME/.config/hypr/bindings.lua ]]; then
      note "no ~/.config/hypr/bindings.lua; Super+K stays English"
    elif ! "$PLUGIN_DIR/menu-keybindings" bind; then
      carry "put Super+K on the translated keybindings menu"
    fi
  else
    note "no menu translation for $table yet; the menu stays English"
  fi
else
  say "4/5  Leaving the menu in English"
fi

say "5/5  Installing the string catalog"
# Read by the translated panel plugins. Installed only when absent: once it is
# in the user's config it is theirs to edit.
language="${LOCALE%%.*}"; language="${language%%@*}"; language="${language%%_*}"
catalog_file="$HOME/.config/omarchy/locales/$language.json"
if [[ ! -x "$PLUGIN_DIR/catalog" ]]; then
  note "this plugin version ships no catalog"
elif ! "$PLUGIN_DIR/catalog" install "$LOCALE"; then
  if [[ -f "$PLUGIN_DIR/locales/$language.json" ]]; then
    carry "install the catalog to $catalog_file"
  else
    note "no catalog for $language yet; the panels stay English"
  fi
fi

# What the panels actually read, checked rather than assumed. Every string in
# every panel resolves through this one file, so its absence is the difference
# between a translated desktop and an English one -- and the only visible
# symptom is English text, which looks like nothing having run at all.
if [[ -f "$PLUGIN_DIR/locales/$language.json" && ! -f $catalog_file ]]; then
  carry "put the catalog at $catalog_file (the panels read it; without it they stay English)"
fi

if (( ${#unfinished[@]} )); then
  printf '\n\033[1mDone, except for %s:\033[0m\n' \
    "$( (( ${#unfinished[@]} == 1 )) && echo "one thing" || echo "${#unfinished[@]} things")"
  for item in "${unfinished[@]}"; do printf '  - %s\n' "$item"; done
  cat <<PARTIAL

Everything else is in place. This is safe to run again -- it picks up where it
left off -- and a failure here is worth reporting:
https://github.com/sbelcl/omarchy-language/issues
PARTIAL
  exit 1
fi

cat <<DONE

Done. Log out and back in to finish: LANG is read at login, so the desktop
is still running the language it started in.

  The bar widget shows the language and can change it later.
  The menu switches back to English from the same panel.
  Omarchy's own panels and dialogs stay English -- that part needs upstream:
  https://github.com/omacom/omarchy/issues/7284
DONE
